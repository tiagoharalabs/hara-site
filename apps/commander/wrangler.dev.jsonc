{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hara-commander-dev-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "DEV",
    "STORAGE_MODE": "REMOTE_DEV",
    "MCP_BASE_URL": "https://mcp.haralabs.com.br/mcp",
    "MCP_ACCESS_ISSUER": "https://proud-sun-7542.cloudflareaccess.com",
    "AUTH_ISSUER": "https://auth.haralabs.com.br/",
    "AUTH_CLIENT_ID": "391790882505949187",
    "AUTH_PROVIDER_LABEL": "HARA Identity",
    "AUTH_CLIENT_AUTH": "BASIC",
    "DEVICE_EVENT_V2_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "PRODUCT_DB",
      "database_name": "hara-commander-product-dev",
      "database_id": "698afbb9-e4eb-4c4e-98f2-f5abe28219d3",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_QUOTA",
        "class_name": "TenantQuota"
      },
      {
        "name": "DEVICE_CHANNEL",
        "class_name": "DeviceChannel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TenantQuota"
      ]
    },
    {
      "tag": "v2",
      "new_classes": [
        "DeviceChannel"
      ]
    }
  ]
}
