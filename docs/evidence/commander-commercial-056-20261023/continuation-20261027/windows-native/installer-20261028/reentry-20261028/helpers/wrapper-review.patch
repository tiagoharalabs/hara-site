+function Assert-QAReleaseWindow {
+  $r.qa_release_window_checked=$false
+  if($cfg.PSObject.Properties['qa_administrative_trust_until_utc']){
+    $deadline=[DateTimeOffset]::MinValue
+    Need ([DateTimeOffset]::TryParse([string]$cfg.qa_administrative_trust_until_utc,[ref]$deadline)) 'QA_RELEASE_WINDOW_INVALID'
+    $r.qa_release_window_checked=$true;$r.qa_release_window_deadline_utc=$deadline.UtcDateTime.ToString('o')
+    Need ($deadline -gt [DateTimeOffset]::UtcNow) 'QA_RELEASE_WINDOW_EXPIRED'
+  }
+}
+function Assert-QAReleaseReachable {
+  # Availability only: the unchanged official preflight still verifies the signed
+  # manifest, and the QA payload guard still verifies the complete Agent bytes.
+  $qaProbeUri=$r.release_url+'/release/agent-manifest.json'
+  $qaProbeResponse=$null;$r.qa_release_reachable=$false
+  try{
+    $qaProbeRequest=[Net.HttpWebRequest]::Create($qaProbeUri)
+    $qaProbeRequest.Method='GET';$qaProbeRequest.AllowAutoRedirect=$false
+    $qaProbeRequest.Timeout=15000;$qaProbeRequest.ReadWriteTimeout=15000
+    $qaProbeRequest.UserAgent='HARA-Commander-QA-Availability/1'
+    $qaProbeResponse=$qaProbeRequest.GetResponse()
+    $r.qa_release_http_status=[int]$qaProbeResponse.StatusCode
+    Need ($r.qa_release_http_status -eq 200 -and $qaProbeResponse.ResponseUri.AbsoluteUri -ceq $qaProbeUri -and $qaProbeResponse.ContentLength -gt 0 -and $qaProbeResponse.ContentLength -le 16384) 'QA_RELEASE_RESPONSE_INVALID'
+    $r.qa_release_reachable=$true
+  }catch{
+    $qaProbeCause=$_.Exception
+    for($qaCauseDepth=0;$qaCauseDepth -lt 8 -and $qaProbeCause;$qaCauseDepth++){
+      if($qaProbeCause -is [Net.WebException]){
+        $r.qa_release_transport_status=[string]$qaProbeCause.Status
+        if($qaProbeCause.Response){$r.qa_release_http_status=[int]$qaProbeCause.Response.StatusCode;$qaProbeCause.Response.Close()}
+        break
+      }
+      $qaProbeCause=$qaProbeCause.InnerException
+    }
+    if([string]$_.Exception.Message -ceq 'QA_RELEASE_RESPONSE_INVALID'){throw 'QA_RELEASE_RESPONSE_INVALID'}
+    throw 'QA_RELEASE_UNAVAILABLE'
+  }finally{if($qaProbeResponse){$qaProbeResponse.Close()}}
