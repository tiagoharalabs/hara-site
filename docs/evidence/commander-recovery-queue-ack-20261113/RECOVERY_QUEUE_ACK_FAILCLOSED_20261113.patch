+test('DELIVER queued before feature disabled must retry and never ACK without receipt',async t=>{
+ const f=fixture(t);f.env.COMMANDER_RECOVERY_DELIVERY_ENABLED='true';
+ f.addDevice(1,{seen:-1000});f.addEvent(1);
+ await f.produce({scan:false});
+ const job=f.jobs().find(x=>x.kind==='DELIVER');assert.ok(job);
+ f.env.COMMANDER_RECOVERY_DELIVERY_ENABLED='false';
+ const first=await f.consume(job);
+ assert.equal(first.result.state,'RETRY');
+ assert.equal(first.calls.ack,0);
+ assert.deepEqual(first.calls.retry,[{delaySeconds:60}]);
+ assert.equal(f.metrics.fetches.length,0);
+ assert.equal(f.db.prepare('SELECT COUNT(*) AS n FROM recovery_delivery_outbox').get().n,0);
+ f.env.COMMANDER_RECOVERY_DELIVERY_ENABLED='true';
+ const resumed=await f.consume(job);
+ assert.equal(resumed.calls.ack,1);
+ assert.equal(resumed.calls.retry.length,0);
+ assert.equal(f.db.prepare('SELECT state FROM recovery_delivery_outbox').get().state,'DELIVERED');
+ assert.equal(f.recipient.prepare('SELECT COUNT(*) AS n FROM receipt').get().n,1);
+});
+test('DELIVER synthetic queued while delivery stays disabled is retried fail closed',async t=>{
+ const f=fixture(t);f.addDevice(1,{seen:-1000});f.addEvent(1);
+ const r=await f.consume(delivery([eventId(1)]));
+ assert.equal(r.calls.ack,0);
+ assert.deepEqual(r.calls.retry,[{delaySeconds:60}]);
+ assert.equal(r.result.state,'RETRY');
+ assert.equal(r.result.result.state,'DISABLED');
+ assert.equal(f.metrics.fetches.length,0);
+});
